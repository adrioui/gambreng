{
  "name": "gambreng",
  "version": "1.0.0",
  "homepage": "https://github.com/adrioui/gambreng#readme",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrioui/gambreng.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc --noEmit && vp build",
    "preview": "vp preview",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "check": "vp check",
    "staged": "vp staged",
    "test": "vp test",
    "test:run": "vp test run",
    "test:coverage": "vp test run --coverage",
    "knip": "knip",
    "knip:ci": "knip --cache --no-progress",
    "deploy:pages": "wrangler pages deploy dist --project-name=gambreng",
    "prepare": "husky"
  },
  "dependencies": {
    "gsap": "^3.14.2",
    "three": "^0.172.0"
  },
  "devDependencies": {
    "@types/three": "^0.172.0",
    "@vitest/coverage-v8": "^4.0.0-beta.10",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "knip": "^6.0.4",
    "typescript": "^5.9.3",
    "vite-plus": "^0.1.13",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest",
    "vitest-webgl-canvas-mock": "^1.1.0",
    "wrangler": "^4.76.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  }
}
